# Copy to backend/.env (never commit .env)
# Supabase -> Connect -> "Session pooler" connection string (works from Render; IPv4).
# Leave DATABASE_URL empty to run with the in-memory store (data is lost on restart).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:3000
