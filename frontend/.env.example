# Copy to frontend/.env.local (never commit it)
# Where the FastAPI backend runs. On Render: the backend service URL, e.g. https://interview-studio-api.onrender.com
API_ORIGIN=http://127.0.0.1:8000
# Login (S1-0.1). Leave both empty to run in guest mode (no login); set both to require login.
# Supabase -> Project Settings -> API: Project URL and the publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
